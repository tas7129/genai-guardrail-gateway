# Copy to .env to override defaults (optional). Never commit .env.

# Local LLM served by Ollama. Keep it on 127.0.0.1 so only the gateway can reach it.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# For laptops with 8 GB RAM or less:  OLLAMA_MODEL=qwen2.5:1.5b

# Local content-safety classifier (only classifies, never answers). Requests are BLOCKED if it is missing
# or gives no verdict (SAFETY_FAIL_MODE=closed). llama-guard3:8b is more accurate but needs ~5 GB RAM.
SAFETY_MODEL=llama-guard3:1b
SAFETY_FAIL_MODE=closed
SAFETY_TIMEOUT_S=60

# Identity: demo (pick any user in the sidebar – presentations only) or pin (PIN sign-in, signed cookie)
GG_AUTH_MODE=demo

# Windows only, if Tesseract is not found automatically:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Gateway web server
GG_HOST=127.0.0.1
GG_PORT=8000

# Policy store backend: chroma (default) or memory
POLICY_BACKEND=chroma

# Requests with this many personal identifiers count as bulk records (manager approval)
BULK_PERSONAL_THRESHOLD=5
